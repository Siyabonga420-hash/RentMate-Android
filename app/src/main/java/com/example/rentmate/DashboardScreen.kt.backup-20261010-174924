// =====================================================
// FRIENDLY STATUS TEXT
// =====================================================

private fun friendlyStatus(
    status: String
): String {

    return when (status.lowercase(Locale.US)) {

        "paid" -> "Paid"

        "partial" -> "Partially Paid"

        "unpaid" -> "Payment Outstanding"

        "completed" -> "Completed"

        "pending" -> "Pending"

        "none" -> "Not Available"

        else -> status
            .replace("_", " ")
            .replaceFirstChar {
                it.uppercase()
            }
    }
}

// =====================================================
// BOOKING STATUS
// =====================================================

private fun getBookingStatus(
    start: String,
    end: String
): String {

    val startTime = parseBookingTimestamp(start)
    val endTime = parseBookingTimestamp(end)

    if (startTime == null || endTime == null) {
        return "Scheduled"
    }

    val now = System.currentTimeMillis()

    return when {

        now < startTime -> "Upcoming"

        now >= startTime && now < endTime -> "In progress"

        else -> "Completed"
    }
}

// =====================================================
// SOUTH AFRICAN CURRENCY
// =====================================================

private fun formatRentMoney(
    amount: Double
): String {

    val formatter = NumberFormat.getCurrencyInstance(
        Locale.forLanguageTag("en-ZA")
    )

    return formatter.format(amount)
}

// =====================================================
// BOOKING DATE AND TIME PICKER
// ANDROID API 24 COMPATIBLE
// =====================================================

private fun showBookingDateTimePicker(
    context: Context,
    onSelected: (String) -> Unit
) {

    val now = Calendar.getInstance()

    DatePickerDialog(
        context,

        { _, year, month, day ->

            TimePickerDialog(
                context,

                { _, hour, minute ->

                    val selectedCalendar =
                        Calendar.getInstance().apply {

                            set(
                                Calendar.YEAR,
                                year
                            )

                            set(
                                Calendar.MONTH,
                                month
                            )

                            set(
                                Calendar.DAY_OF_MONTH,
                                day
                            )

                            set(
                                Calendar.HOUR_OF_DAY,
                                hour
                            )

                            set(
                                Calendar.MINUTE,
                                minute
                            )

                            set(
                                Calendar.SECOND,
                                0
                            )

                            set(
                                Calendar.MILLISECOND,
                                0
                            )
                        }

                    val formatter = SimpleDateFormat(
                        "yyyy-MM-dd'T'HH:mm:ssXXX",
                        Locale.US
                    )

                    formatter.timeZone =
                        TimeZone.getDefault()

                    val isoDateTime =
                        formatter.format(
                            selectedCalendar.time
                        )

                    onSelected(isoDateTime)
                },

                now.get(Calendar.HOUR_OF_DAY),

                now.get(Calendar.MINUTE),

                true

            ).show()
        },

        now.get(Calendar.YEAR),

        now.get(Calendar.MONTH),

        now.get(Calendar.DAY_OF_MONTH)

    ).show()
}

// =====================================================
// PARSE TIMESTAMP
// ANDROID API 24 COMPATIBLE
// =====================================================

private fun parseBookingTimestamp(
    iso: String
): Long? {

    if (iso.isBlank() || iso == "null") {
        return null
    }

    return try {

        val normalized = iso.replace(
            Regex("\\.(\\d+)(?=Z|[+-]\\d{2}:?\\d{2}$)")
        ) { match ->

            "." + match.groupValues[1]
                .padEnd(3, '0')
                .take(3)
        }

        val patterns = listOf(
            "yyyy-MM-dd'T'HH:mm:ss.SSSXXX",
            "yyyy-MM-dd'T'HH:mm:ssXXX",
            "yyyy-MM-dd"
        )

        var parsedTime: Long? = null

        for (pattern in patterns) {

            try {

                val formatter = SimpleDateFormat(
                    pattern,
                    Locale.US
                )

                formatter.isLenient = false

                val date = formatter.parse(normalized)

                if (date != null) {

                    parsedTime = date.time
                    break
                }

            } catch (_: Exception) {

                // Try the next format.
            }
        }

        parsedTime

    } catch (_: Exception) {

        null
    }
}

// =====================================================
// DISPLAY READABLE DATE AND TIME
// ANDROID API 24 COMPATIBLE
// =====================================================

private fun displayBookingTime(
    iso: String
): String {

    if (iso.isBlank() || iso == "null") {
        return "Not available"
    }

    return try {

        val timestamp = parseBookingTimestamp(iso)

        if (timestamp == null) {

            iso

        } else {

            val isDateOnly =
                Regex("^\\d{4}-\\d{2}-\\d{2}$")
                    .matches(iso)

            val outputPattern = if (isDateOnly) {
                "dd MMM yyyy"
            } else {
                "dd MMM yyyy, HH:mm"
            }

            val outputFormatter = SimpleDateFormat(
                outputPattern,
                Locale.ENGLISH
            )

            outputFormatter.timeZone =
                TimeZone.getDefault()

            outputFormatter.format(
                Date(timestamp)
            )
        }

    } catch (_: Exception) {

        iso
    }
}

