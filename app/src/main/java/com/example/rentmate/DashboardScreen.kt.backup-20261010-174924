// =====================================================
// RENTMATE COLOURS
// =====================================================

private val dashboardNavy = Color(0xFF2D3142)
private val dashboardOrange = Color(0xFFF56038)
private val dashboardPink = Color(0xFFE83E91)
private val dashboardBlue = Color(0xFF506079)
private val dashboardGreen = Color(0xFF00813D)
private val dashboardBackground = Color(0xFFF4F5F7)
private val dashboardMuted = Color(0xFF777D8A)

// =====================================================
// DASHBOARD FEATURE MODEL
// =====================================================

private data class DashboardFeature(
    val title: String,
    val icon: ImageVector,
    val colour: Color,
    val section: String
)

// =====================================================
// MAIN TENANT DASHBOARD
// =====================================================

@Composable
fun DashboardScreen(
    onProfileClick: () -> Unit,
    onSettingsClick: () -> Unit = {},
    onLogoutClick: () -> Unit = {},
    onFindAccommodationClick: () -> Unit = {},
    onFeatureNavigate: (String) -> Unit = {}
) {

    val context = LocalContext.current
    val repo = remember { RentMateRepository() }
    val scope = rememberCoroutineScope()

    // -------------------------------------------------
    // DASHBOARD STATE
    // -------------------------------------------------

    var dashboard by remember {
        mutableStateOf<JSONObject?>(null)
    }

    var loading by remember {
        mutableStateOf(true)
    }

    var dashboardError by remember {
        mutableStateOf("")
    }

    // -------------------------------------------------
    // SECTION STATE
    // -------------------------------------------------

    var selectedSection by remember {
        mutableStateOf<String?>(null)
    }

    var sectionItems by remember {
        mutableStateOf(JSONArray())
    }

    var sectionLoading by remember {
        mutableStateOf(false)
    }

    var sectionError by remember {
        mutableStateOf("")
    }

    // -------------------------------------------------
    // ADD RECORD STATE
    // -------------------------------------------------

    var showCreate by remember {
        mutableStateOf(false)
    }

    var createTitle by remember {
        mutableStateOf("")
    }

    var bookingStart by remember {
        mutableStateOf("")
    }

    var bookingEnd by remember {
        mutableStateOf("")
    }

    var createError by remember {
        mutableStateOf("")
    }

    var saving by remember {
        mutableStateOf(false)
    }

    // -------------------------------------------------
    // REFRESH DASHBOARD
    // -------------------------------------------------

    suspend fun refreshDashboard() {

        loading = true
        dashboardError = ""

        try {

            dashboard = repo.getDashboardJson()

        } catch (e: Exception) {

            dashboardError =
                e.message ?: "Unable to load your dashboard."

            dashboard = null

        } finally {

            loading = false
        }
    }

    // -------------------------------------------------
    // OPEN A DASHBOARD SECTION
    // -------------------------------------------------

    fun openSection(name: String) {

        selectedSection = name
        sectionItems = JSONArray()
        sectionError = ""
        sectionLoading = true

        scope.launch {

            try {

                sectionItems = when (name) {

                    "Chores" -> repo.getChores()

                    "Shared Groceries" -> repo.getGroceries()

                    "Kitchen & Braai" -> repo.getBookings()

                    "Rent" -> repo.getRentHistory()

                    "Payments" -> repo.getPayments()

                    "Announcements" -> repo.getAnnouncements()

                    "Expenses" -> repo.getExpenses()

                    "Expense splits" -> repo.getExpenseSplits()

                    else -> JSONArray()
                }

            } catch (e: Exception) {

                sectionError =
                    e.message ?: "Unable to load $name."

            } finally {

                sectionLoading = false
            }
        }
    }

    // -------------------------------------------------
    // LOAD DATA WHEN DASHBOARD OPENS
    // -------------------------------------------------

    LaunchedEffect(RentMateSession.userId) {

        refreshDashboard()
    }

    // -------------------------------------------------
    // TENANT INFORMATION
    // -------------------------------------------------

    val assigned =
        dashboard?.optBoolean("assigned", false) == true

    val userName = dashboard
        ?.optString("user_name", "")
        .orEmpty()
        .ifBlank { "Tenant" }

    val firstName = userName
        .trim()
        .substringBefore(" ")
        .ifBlank { "Tenant" }

    val household =
        dashboard?.optJSONObject("household")

    val householdName = household
        ?.optString("name", "")
        .orEmpty()

    val memberCount =
        household?.optInt("member_count", 0) ?: 0

    val householdType = household
        ?.optString("type", "")
        .orEmpty()

    val pinnedNote = household
        ?.optString("pinned_note", "")
        .orEmpty()

    // -------------------------------------------------
    // INDIVIDUAL RENT INFORMATION
    // -------------------------------------------------

    val rentDue =
        dashboard?.optDouble("rent_due", 0.0) ?: 0.0

    val amountPaid =
        dashboard?.optDouble("amount_paid", 0.0) ?: 0.0

    val outstanding =
        dashboard?.optDouble("outstanding", 0.0) ?: 0.0

    val dueDate = dashboard
        ?.optString("due_date", "")
        .orEmpty()

    val paymentStatus = dashboard
        ?.optString("payment_status", "")
        .orEmpty()

    // -------------------------------------------------
    // DASHBOARD FEATURES
    // -------------------------------------------------

    val features = remember {

        listOf(

            DashboardFeature(
                title = "Commune Chores",
                icon = Icons.Filled.CheckCircle,
                colour = dashboardBlue,
                section = "Chores"
            ),

            DashboardFeature(
                title = "Kitchen & Braai",
                icon = Icons.Filled.Event,
                colour = dashboardPink,
                section = "Kitchen & Braai"
            ),

            DashboardFeature(
                title = "Shared Groceries",
                icon = Icons.Filled.ShoppingCart,
                colour = dashboardOrange,
                section = "Shared Groceries"
            ),

            DashboardFeature(
                title = "Rent & Bills",
                icon = Icons.Filled.AccountBalanceWallet,
                colour = dashboardPink,
                section = "Rent"
            ),

            DashboardFeature(
                title = "Announcements",
                icon = Icons.Filled.Campaign,
                colour = dashboardOrange,
                section = "Announcements"
            ),

            DashboardFeature(
                title = "Payments",
                icon = Icons.Filled.Payment,
                colour = dashboardBlue,
                section = "Payments"
            )
        )
    }

    // =====================================================
    // MAIN SCREEN
    // =====================================================

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(dashboardBackground)
    ) {

        // =================================================
        // NAVY WELCOME HEADER
        // =================================================

        Column(
            modifier = Modifier
                .fillMaxWidth()
                .background(dashboardNavy)
                .padding(
                    start = 20.dp,
                    end = 20.dp,
                    top = 18.dp,
                    bottom = 26.dp
                )
        ) {

            val today = remember {

                SimpleDateFormat(
                    "EEEE, d MMMM yyyy",
                    Locale.ENGLISH
                ).format(Date())
            }

            Text(
                text = today,
                color = Color.White.copy(alpha = 0.8f),
                fontSize = 13.sp
            )

            Spacer(
                modifier = Modifier.height(22.dp)
            )

            Row(
                modifier = Modifier.fillMaxWidth(),
                verticalAlignment = Alignment.CenterVertically
            ) {

                Column(
                    modifier = Modifier.weight(1f)
                ) {

                    Text(
                        text = "Welcome Back,",
                        color = Color.White.copy(alpha = 0.85f),
                        fontSize = 20.sp,
                        fontWeight = FontWeight.Medium
                    )

                    Spacer(
                        modifier = Modifier.height(4.dp)
                    )

                    Text(
                        text = "$firstName",
                        color = Color.White,
                        fontSize = 29.sp,
                        fontWeight = FontWeight.Bold,
                        maxLines = 2,
                        overflow = TextOverflow.Ellipsis
                    )

                    Spacer(
                        modifier = Modifier.height(6.dp)
                    )

                    Text(
                        text = "Your home, made easier.",
                        color = Color.White.copy(alpha = 0.75f),
                        fontSize = 12.sp
                    )
                }

                Text(
                    text = "ðŸ””",
                    fontSize = 23.sp,
                    modifier = Modifier
                        .clickable {
                            if (assigned) {
                                openSection("Announcements")
                            }
                        }
                        .padding(7.dp)
                )

                Text(
                    text = "ðŸ‘¤",
                    fontSize = 23.sp,
                    modifier = Modifier
                        .clickable {
                            onProfileClick()
                        }
                        .padding(7.dp)
                )

                Text(
                    text = "âš™",
                    color = Color.White,
                    fontSize = 27.sp,
                    modifier = Modifier
                        .clickable {
                            onSettingsClick()
                        }
                        .padding(7.dp)
                )
            }
        }

        // =================================================
        // SCROLLABLE DASHBOARD BODY
        // =================================================

        Column(
            modifier = Modifier
                .fillMaxSize()
                .verticalScroll(rememberScrollState())
                .padding(16.dp)
        ) {

            // ---------------------------------------------
            // LOADING
            // ---------------------------------------------

            if (loading) {

                Box(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(40.dp),
                    contentAlignment = Alignment.Center
                ) {

                    CircularProgressIndicator(
                        color = dashboardGreen
                    )
                }

            } else if (dashboardError.isNotBlank()) {

                // -----------------------------------------
                // ERROR CARD
                // -----------------------------------------

                Card(
                    modifier = Modifier.fillMaxWidth(),
                    shape = RoundedCornerShape(18.dp),
                    colors = CardDefaults.cardColors(
                        containerColor = Color.White
                    )
                ) {

                    Column(
                        modifier = Modifier.padding(20.dp)
                    ) {

                        Text(
                            text = "Unable to load dashboard",
                            fontSize = 18.sp,
                            fontWeight = FontWeight.Bold
                        )

                        Spacer(
                            modifier = Modifier.height(10.dp)
                        )

                        Text(
                            text = dashboardError,
                            color = MaterialTheme.colorScheme.error
                        )

                        Spacer(
                            modifier = Modifier.height(16.dp)
                        )

                        Button(
                            onClick = {
                                scope.launch {
                                    refreshDashboard()
                                }
                            },
                            colors = ButtonDefaults.buttonColors(
                                containerColor = dashboardGreen
                            )
                        ) {

                            Text("Try Again")
                        }
                    }
                }

            } else if (!assigned) {

                // -----------------------------------------
                // UNASSIGNED TENANT
                // -----------------------------------------

                Card(
                    modifier = Modifier.fillMaxWidth(),
                    shape = RoundedCornerShape(22.dp),
                    colors = CardDefaults.cardColors(
                        containerColor = Color.White
                    )
                ) {

                    Column(
                        modifier = Modifier.padding(24.dp)
                    ) {

                        Text(
                            text = "ðŸ ",
                            fontSize = 45.sp
                        )

                        Spacer(
                            modifier = Modifier.height(12.dp)
                        )

                        Text(
                            text = "Welcome to RentMate!",
                            fontSize = 23.sp,
                            fontWeight = FontWeight.Bold,
                            color = dashboardNavy
                        )

                        Spacer(
                            modifier = Modifier.height(10.dp)
                        )

                        Text(
                            text = "Your account is ready.",
                            fontWeight = FontWeight.Medium
                        )

                        Spacer(
                            modifier = Modifier.height(8.dp)
                        )

                        Text(
                            text = "You have not been assigned to a property yet. Once your property manager assigns you to a home, your household features will become available.",
                            color = dashboardMuted,
                            fontSize = 14.sp
                        )

                        Spacer(
                            modifier = Modifier.height(22.dp)
                        )

                        Button(
                            onClick = onFindAccommodationClick,
                            modifier = Modifier.fillMaxWidth(),
                            colors = ButtonDefaults.buttonColors(
                                containerColor = dashboardGreen
                            ),
                            shape = RoundedCornerShape(14.dp)
                        ) {

                            Text("Find Accommodation")
                        }

                        Spacer(
                            modifier = Modifier.height(10.dp)
                        )

                        OutlinedButton(
                            onClick = {
                                scope.launch {
                                    refreshDashboard()
                                }
                            },
                            modifier = Modifier.fillMaxWidth(),
                            shape = RoundedCornerShape(14.dp)
                        ) {

                            Text("Refresh Assignment")
                        }
                    }
                }

            } else {

                // =========================================
                // FIND ACCOMMODATION BUTTON
                // =========================================

                OutlinedButton(
                    onClick = onFindAccommodationClick,
                    modifier = Modifier.fillMaxWidth(),
                    shape = RoundedCornerShape(16.dp),
                    contentPadding = PaddingValues(14.dp)
                ) {

                    Text(
                        text = "ðŸ   Find Accommodation",
                        color = dashboardNavy,
                        fontWeight = FontWeight.SemiBold
                    )
                }

                Spacer(
                    modifier = Modifier.height(24.dp)
                )

                // =========================================
                // HOUSEMATES SECTION
                // =========================================

                Text(
                    text = "Housemates",
                    fontSize = 23.sp,
                    fontWeight = FontWeight.Bold,
                    color = dashboardNavy
                )

                Spacer(
                    modifier = Modifier.height(6.dp)
                )

                Text(
                    text = if (memberCount == 1) {
                        "1 member in your home"
                    } else {
                        "$memberCount members in your home"
                    },
                    color = dashboardMuted,
                    fontSize = 14.sp
                )

                Spacer(
                    modifier = Modifier.height(14.dp)
                )

                Card(
                    modifier = Modifier.fillMaxWidth(),
                    shape = RoundedCornerShape(20.dp),
                    colors = CardDefaults.cardColors(
                        containerColor = Color.White
                    )
                ) {

                    Row(
                        modifier = Modifier.padding(20.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {

                        Surface(
                            modifier = Modifier.size(52.dp),
                            shape = CircleShape,
                            color = dashboardBackground
                        ) {

                            Box(
                                contentAlignment = Alignment.Center
                            ) {

                                Text(
                                    text = "ðŸ ",
                                    fontSize = 25.sp
                                )
                            }
                        }

                        Spacer(
                            modifier = Modifier.width(14.dp)
                        )

                        Column {

                            Text(
                                text = householdName.ifBlank {
                                    "Your Household"
                                },
                                fontSize = 19.sp,
                                fontWeight = FontWeight.Bold,
                                color = dashboardNavy
                            )

                            Spacer(
                                modifier = Modifier.height(5.dp)
                            )

                            Text(
                                text = "$memberCount registered ${if (memberCount == 1) "member" else "members"}",
                                fontSize = 13.sp,
                                color = dashboardMuted
                            )
                        }
                    }
                }

                Spacer(
                    modifier = Modifier.height(18.dp)
                )

                // =========================================
                // HOUSEHOLD TYPE
                // =========================================

                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.spacedBy(12.dp)
                ) {

                    HouseholdTypeButton(
                        text = "Student Commune",
                        selected = householdType.equals(
                            "student_commune",
                            ignoreCase = true
                        ),
                        modifier = Modifier.weight(1f)
                    )

                    HouseholdTypeButton(
                        text = "Family Home",
                        selected = householdType.equals(
                            "family_home",
                            ignoreCase = true
                        ),
                        modifier = Modifier.weight(1f)
                    )
                }

                Spacer(
                    modifier = Modifier.height(20.dp)
                )

                // =========================================
                // PINNED NOTE
                // =========================================

                Card(
                    modifier = Modifier.fillMaxWidth(),
                    shape = RoundedCornerShape(20.dp),
                    colors = CardDefaults.cardColors(
                        containerColor = Color.White
                    )
                ) {

                    Column(
                        modifier = Modifier.padding(20.dp)
                    ) {

                        Text(
                            text = "ðŸ“Œ Pinned Note",
                            fontSize = 19.sp,
                            fontWeight = FontWeight.Bold,
                            color = dashboardNavy
                        )

                        Spacer(
                            modifier = Modifier.height(10.dp)
                        )

                        Text(
                            text = pinnedNote.ifBlank {
                                "No announcements pinned to your home yet."
                            },
                            fontSize = 14.sp,
                            color = dashboardMuted
                        )
                    }
                }

                Spacer(
                    modifier = Modifier.height(22.dp)
                )

                // =========================================
                // RENT OVERVIEW
                // =========================================

                RentOverviewCard(
                    rentDue = rentDue,
                    amountPaid = amountPaid,
                    outstanding = outstanding,
                    dueDate = dueDate,
                    paymentStatus = paymentStatus,
                    onPaymentsClick = {
                        openSection("Payments")
                    },
                    onRentClick = {
                        openSection("Rent")
                    }
                )

                Spacer(
                    modifier = Modifier.height(26.dp)
                )

                // =========================================
                // DASHBOARD FEATURE SECTION
                // =========================================

                Text(
                    text = "RentMate Dashboard",
                    fontSize = 23.sp,
                    fontWeight = FontWeight.Bold,
                    color = dashboardNavy
                )

                Spacer(
                    modifier = Modifier.height(6.dp)
                )

                Text(
                    text = "Everything you need to manage your shared home.",
                    color = dashboardMuted,
                    fontSize = 14.sp
                )

                Spacer(
                    modifier = Modifier.height(20.dp)
                )

                // =========================================
                // ORIGINAL CIRCULAR FEATURE BUTTONS
                // =========================================

                features.chunked(2).forEach { rowFeatures ->

                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.spacedBy(14.dp)
                    ) {

                        rowFeatures.forEach { feature ->

                            Box(
                                modifier = Modifier.weight(1f)
                            ) {

                                CircularDashboardFeature(
                                    feature = feature,
                                    onClick = {
                                        when (feature.section) {

                                            "Chores" -> {
                                                onFeatureNavigate("chores")
                                            }

                                            "Shared Groceries" -> {
                                                onFeatureNavigate("groceries")
                                            }

                                            "Kitchen & Braai" -> {
                                                onFeatureNavigate("kitchen_bookings")
                                            }

                                            else -> {
                                                openSection(feature.section)
                                            }
                                        }
                                    }
                                )
                            }
                        }
                    }

                    Spacer(
                        modifier = Modifier.height(16.dp)
                    )
                }

                Spacer(
                    modifier = Modifier.height(16.dp)
                )
            }
        }
    }

    // =====================================================
    // SECTION DIALOG
    // =====================================================

    selectedSection?.let { currentSection ->

        AlertDialog(
            onDismissRequest = {
                if (!showCreate) {
                    selectedSection = null
                }
            },

            shape = RoundedCornerShape(26.dp),

            containerColor = Color(0xFFF0EAF4),

            title = {

                Text(
                    text = currentSection,
                    fontSize = 23.sp,
                    fontWeight = FontWeight.Bold,
                    color = dashboardNavy
                )
            },

            text = {

                Column(
                    modifier = Modifier
                        .fillMaxWidth()
                        .heightIn(max = 440.dp)
                        .verticalScroll(rememberScrollState()),
                    verticalArrangement = Arrangement.spacedBy(12.dp)
                ) {

                    if (sectionLoading) {

                        Box(
                            modifier = Modifier
                                .fillMaxWidth()
                                .padding(24.dp),
                            contentAlignment = Alignment.Center
                        ) {

                            CircularProgressIndicator(
                                color = dashboardGreen
                            )
                        }

                    } else if (sectionError.isNotBlank()) {

                        Text(
                            text = sectionError,
                            color = MaterialTheme.colorScheme.error
                        )

                        TextButton(
                            onClick = {
                                openSection(currentSection)
                            }
                        ) {

                            Text("Try Again")
                        }

                    } else if (sectionItems.length() == 0) {

                        EmptySectionMessage(
                            section = currentSection
                        )

                    } else {

                        for (i in 0 until sectionItems.length()) {

                            val item =
                                sectionItems.optJSONObject(i)
                                    ?: continue

                            SectionRecord(
                                item = item,
                                section = currentSection,

                                onCompleteChore = { id ->

                                    scope.launch {

                                        sectionLoading = true
                                        sectionError = ""

                                        try {

                                            repo.completeChore(id)

                                            sectionItems =
                                                repo.getChores()

                                            dashboard =
                                                repo.getDashboardJson()

                                        } catch (e: Exception) {

                                            sectionError =
                                                e.message
                                                    ?: "Unable to complete chore."

                                        } finally {

                                            sectionLoading = false
                                        }
                                    }
                                },

                                onPurchaseGrocery = { id ->

                                    scope.launch {

                                        sectionLoading = true
                                        sectionError = ""

                                        try {

                                            repo.purchaseGrocery(id)

                                            sectionItems =
                                                repo.getGroceries()

                                        } catch (e: Exception) {

                                            sectionError =
                                                e.message
                                                    ?: "Unable to update grocery."

                                        } finally {

                                            sectionLoading = false
                                        }
                                    }
                                }
                            )
                        }
                    }
                }
            },

            confirmButton = {

                Row {

                    if (
                        currentSection in listOf(
                            "Chores",
                            "Shared Groceries",
                            "Kitchen & Braai"
                        )
                    ) {

                        TextButton(
                            onClick = {

                                createTitle = ""
                                bookingStart = ""
                                bookingEnd = ""
                                createError = ""

                                showCreate = true
                            }
                        ) {

                            Text(
                                text = "+ Add new",
                                color = dashboardGreen,
                                fontWeight = FontWeight.Bold
                            )
                        }
                    }

                    TextButton(
                        onClick = {
                            selectedSection = null
                        }
                    ) {

                        Text(
                            text = "Close",
                            color = dashboardNavy
                        )
                    }
                }
            }
        )
    }

    // =====================================================
    // CREATE NEW RECORD DIALOG
    // =====================================================

    if (showCreate && selectedSection != null) {

        val kind = selectedSection!!

        AlertDialog(
            onDismissRequest = {
                if (!saving) {
                    showCreate = false
                }
            },

            shape = RoundedCornerShape(24.dp),

            title = {

                Text(
                    text = when (kind) {

                        "Chores" -> "Add a Chore"

                        "Shared Groceries" -> "Add Grocery Item"

                        "Kitchen & Braai" -> "Book Kitchen & Braai"

                        else -> "Add New"
                    },
                    fontWeight = FontWeight.Bold
                )
            },

            text = {

                Column(
                    verticalArrangement = Arrangement.spacedBy(14.dp)
                ) {

                    OutlinedTextField(
                        value = createTitle,

                        onValueChange = {
                            createTitle = it
                            createError = ""
                        },

                        label = {

                            Text(
                                when (kind) {

                                    "Shared Groceries" -> "What do you need?"

                                    "Kitchen & Braai" -> "Booking name"

                                    "Chores" -> "Chore name"

                                    else -> "Title"
                                }
                            )
                        },

                        placeholder = {

                            Text(
                                when (kind) {

                                    "Shared Groceries" -> "e.g. Milk"

                                    "Kitchen & Braai" -> "e.g. Saturday Braai"

                                    "Chores" -> "e.g. Wash dishes"

                                    else -> "Enter a title"
                                }
                            )
                        },

                        singleLine = true,

                        modifier = Modifier.fillMaxWidth()
                    )

                    // -------------------------------------
                    // BOOKING DATE AND TIME
                    // -------------------------------------

                    if (kind == "Kitchen & Braai") {

                        Text(
                            text = "Choose when you want to use the kitchen or braai area.",
                            fontSize = 13.sp,
                            color = dashboardMuted
                        )

                        OutlinedButton(
                            onClick = {

                                showBookingDateTimePicker(
                                    context = context,
                                    onSelected = {

                                        bookingStart = it
                                        createError = ""
                                    }
                                )
                            },

                            modifier = Modifier.fillMaxWidth()
                        ) {

                            Text(
                                text = if (bookingStart.isBlank()) {
                                    "ðŸ“… Select Start Date & Time"
                                } else {
                                    "Starts: ${displayBookingTime(bookingStart)}"
                                }
                            )
                        }

                        OutlinedButton(
                            onClick = {

                                showBookingDateTimePicker(
                                    context = context,
                                    onSelected = {

                                        bookingEnd = it
                                        createError = ""
                                    }
                                )
                            },

                            modifier = Modifier.fillMaxWidth()
                        ) {

                            Text(
                                text = if (bookingEnd.isBlank()) {
                                    "ðŸ“… Select End Date & Time"
                                } else {
                                    "Ends: ${displayBookingTime(bookingEnd)}"
                                }
                            )
                        }
                    }

                    if (createError.isNotBlank()) {

                        Text(
                            text = createError,
                            color = MaterialTheme.colorScheme.error,
                            fontSize = 13.sp
                        )
                    }

                    if (saving) {

                        LinearProgressIndicator(
                            modifier = Modifier.fillMaxWidth()
                        )
                    }
                }
            },

            confirmButton = {

                Button(
                    enabled = !saving,

                    onClick = {

                        createError = ""

                        val title = createTitle.trim()

                        if (title.isBlank()) {

                            createError =
                                "Please enter a name."

                        } else if (title.length > 150) {

                            createError =
                                "Please use fewer than 150 characters."

                        } else if (
                            kind == "Kitchen & Braai" &&
                            (
                                    bookingStart.isBlank() ||
                                            bookingEnd.isBlank()
                                    )
                        ) {

                            createError =
                                "Please select both start and end times."

                        } else if (
                            kind == "Kitchen & Braai" &&
                            (
                                    parseBookingTimestamp(bookingStart) == null ||
                                            parseBookingTimestamp(bookingEnd) == null
                                    )
                        ) {

                            createError =
                                "Please select valid booking dates."

                        } else if (
                            kind == "Kitchen & Braai" &&
                            (
                                    parseBookingTimestamp(bookingStart)!! <
                                            System.currentTimeMillis()
                                    )
                        ) {

                            createError =
                                "You cannot book a date in the past."

                        } else if (
                            kind == "Kitchen & Braai" &&
                            (
                                    parseBookingTimestamp(bookingEnd)!! <=
                                            parseBookingTimestamp(bookingStart)!!
                                    )
                        ) {

                            createError =
                                "The end time must be after the start time."

                        } else {

                            scope.launch {

                                saving = true

                                try {

                                    when (kind) {

                                        "Chores" -> {

                                            repo.createChore(title)
                                        }

                                        "Shared Groceries" -> {

                                            repo.addGrocery(title)
                                        }

                                        "Kitchen & Braai" -> {

                                            repo.addBooking(
                                                title = title,
                                                start = bookingStart,
                                                end = bookingEnd
                                            )
                                        }
                                    }

                                    showCreate = false

                                    openSection(kind)

                                } catch (e: Exception) {

                                    createError =
                                        e.message ?: "Unable to save."

                                } finally {

                                    saving = false
                                }
                            }
                        }
                    },

                    colors = ButtonDefaults.buttonColors(
                        containerColor = dashboardGreen
                    )
                ) {

                    Text("Save")
                }
            },

            dismissButton = {

                TextButton(
                    enabled = !saving,

                    onClick = {
                        showCreate = false
                    }
                ) {

                    Text("Cancel")
                }
            }
        )
    }
}

