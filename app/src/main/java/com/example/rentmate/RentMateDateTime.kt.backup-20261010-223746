package com.example.rentmate

import android.app.DatePickerDialog
import android.app.TimePickerDialog
import android.content.Context
import java.text.SimpleDateFormat
import java.util.Calendar
import java.util.Locale

fun pickRentMateDateTime(context: Context, onSelected: (String) -> Unit) {

    val now = Calendar.getInstance()

    val dateDialog = DatePickerDialog(
        context,
        { _, year, month, day ->

            val currentTime = Calendar.getInstance()

            val timeDialog = TimePickerDialog(
                context,
                { _, hour, minute ->

                    val selectedDate = Calendar.getInstance().apply {
                        set(year, month, day, hour, minute, 0)
                        set(Calendar.MILLISECOND, 0)
                    }

                    if (!selectedDate.after(Calendar.getInstance())) {

                        android.widget.Toast.makeText(
                            context,
                            "Please select a future date and time.",
                            android.widget.Toast.LENGTH_LONG
                        ).show()

                    } else {

                        val formattedDate = SimpleDateFormat(
                            "yyyy-MM-dd'T'HH:mm:ssXXX",
                            Locale.US
                        ).format(selectedDate.time)

                        onSelected(formattedDate)
                    }
                },
                currentTime.get(Calendar.HOUR_OF_DAY),
                currentTime.get(Calendar.MINUTE),
                true
            )

            timeDialog.show()
        },
        now.get(Calendar.YEAR),
        now.get(Calendar.MONTH),
        now.get(Calendar.DAY_OF_MONTH)
    )

    // Disable all dates before today
    val startOfToday = Calendar.getInstance().apply {
        set(Calendar.HOUR_OF_DAY, 0)
        set(Calendar.MINUTE, 0)
        set(Calendar.SECOND, 0)
        set(Calendar.MILLISECOND, 0)
    }

    dateDialog.datePicker.minDate = startOfToday.timeInMillis

    dateDialog.show()
}

fun formatRentMateDateTime(value: String): String {
    if (value.isBlank() || value == "null") return "Not scheduled"
    return try {
        val normalized = value.replace(Regex("\\.(\\d+)(?=Z|[+-]\\d{2}:?\\d{2}$)")) {
            "." + it.groupValues[1].padEnd(3, '0').take(3)
        }
        val patterns = listOf("yyyy-MM-dd'T'HH:mm:ss.SSSXXX", "yyyy-MM-dd'T'HH:mm:ssXXX")
        var formatted = value
        for (pattern in patterns) {
            val parsed = runCatching { SimpleDateFormat(pattern, Locale.US).parse(normalized) }.getOrNull()
            if (parsed != null) {
                formatted = SimpleDateFormat("dd MMM yyyy, HH:mm", Locale.ENGLISH).format(parsed)
                break
            }
        }
        formatted
    } catch (_: Exception) { value }
}
